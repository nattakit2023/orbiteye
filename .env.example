# =============================================================
# Environment variables for Docker build / runtime
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# =============================================================

# ---------- Build-time (ฝังลงใน JS bundle) ----------
# VITE_API_URL: GraphQL endpoint ที่ browser จะเรียกโดยตรง
# ระหว่าง dev ใช้ http://localhost:4321
# ตอน production ถ้าใช้ nginx reverse proxy ให้ตั้งเป็น "/graphql" (same-origin)
# หรือตั้งเป็น public URL ของ backend ตรง ๆ เช่น https://api.example.com
VITE_API_URL=http://localhost:4321

# VITE_BASE_URL: base URL สำหรับ axios instance (REST API อื่น ๆ ที่ไม่ใช่ GraphQL)
VITE_BASE_URL=http://localhost:4321

# VITE_GOOGLE_CLIENT_ID: Google OAuth client ID สำหรับ login
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ---------- Runtime (ใช้ตอน container start) ----------
# BACKEND_URL: URL ที่ nginx จะใช้ proxy /graphql
# ถ้ารัน backend เป็น Docker service ในเครือข่ายเดียวกัน ใช้ชื่อ service เป็น hostname
#   BACKEND_URL=http://backend:4321
# ถ้า backend รันบน host เดียวกัน:
#   BACKEND_URL=http://host.docker.internal:4321
# ถ้า backend อยู่ข้างนอก:
#   BACKEND_URL=https://api.example.com
BACKEND_URL=http://backend:4321